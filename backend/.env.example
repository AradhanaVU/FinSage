DATABASE_URL=sqlite:///./finance_app.db
# Docker Compose Postgres:
# DATABASE_URL=postgresql+psycopg2://finsage:finsage@db:5432/finsage
# Railway: paste ${{Postgres.DATABASE_URL}} (postgres:// is auto-normalized)

SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENV=development
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
# Railway: CORS_ORIGINS=https://your-web.up.railway.app

GEMINI_API_KEY=
OPENAI_API_KEY=
